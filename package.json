{
  "name": "initrepo-cli",
  "version": "2.0.2",
  "description": "A CLI tool to extract and analyze codebase context for AI consumption and scaffold new projects",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "initrepo-cli": "./bin/initrepo.js"
  },
  "scripts": {
    "start": "node bin/initrepo.js",
    "dev": "node bin/initrepo.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "cli",
    "codebase",
    "analysis",
    "ai",
    "documentation",
    "extraction",
    "scaffolding",
    "nextjs",
    "react",
    "python",
    "automation"
  ],
  "author": "InitRepo Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/generator": "^7.23.0",
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "ast-types": "^0.16.1",
    "commander": "^11.1.0",
    "complexity-report": "^2.0.0-alpha",
    "fast-xml-parser": "^4.3.2",
    "globby": "^14.0.0",
    "jscodeshift": "^17.3.0",
    "minimatch": "^10.0.3",
    "path-to-regexp": "^8.2.0",
    "picocolors": "^1.0.0",
    "recast": "^0.23.11",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.4",
    "memfs": "^4.6.0",
    "vitest": "^1.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/initrepo/cli.git"
  },
  "bugs": {
    "url": "https://github.com/initrepo/cli/issues"
  },
  "homepage": "https://github.com/initrepo/cli#readme"
}
