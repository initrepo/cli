# Ignore specific patterns instead of using catch-all
node_modules/

# Logs and temporary files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage and test output
coverage/
.nyc_output/
*.lcov

# Build outputs and cache
dist/
build/
.cache/
.parcel-cache/
.eslintcache/
.stylelintcache/

# Environment files (keep .env.example if it exists)
.env
.env.*
!.env.example

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp

# Generated files from various tools/frameworks
.next/
.nuxt/
.svelte-kit/
.vuepress/dist/
.docusaurus/
.serverless/
.firebase/
.dynamodb/

# Yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Ignore local development files
INITREPO_ECOSYSTEM.md
bin/

# Generated/AI assistant files
.claude/
.initrepo/
